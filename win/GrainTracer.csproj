<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows shell: WinForms window + WebView2 showing ../index.html. .NET Framework 4.8 ships with Windows 10/11,
       and the WebView2 runtime is part of Windows 11 and current Windows 10, so nothing extra is installed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GrainTracer</AssemblyName>
    <RootNamespace>GrainTracer</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Grain Tracer</Product>
    <AssemblyTitle>Grain Tracer</AssemblyTitle>
    <Company>HongHyun-kr</Company>
    <Copyright>© HongHyun-kr</Copyright>
    <Version>1.1.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\index.html" Link="web\index.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
